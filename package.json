{
  "name": "omp",
  "version": "0.12.1",
  "private": true,
  "type": "module",
  "description": "Media player for LG webOS TVs backed by TorrServer",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "icons": "node scripts/render-icons.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "check:boot": "node scripts/boot-check.mjs",
    "tv:install": "node scripts/tv.mjs install",
    "tv:launch": "node scripts/tv.mjs launch",
    "dev:mobile": "vite --config vite.mobile.config.ts --host",
    "build:mobile": "tsc --noEmit && vite build --config vite.mobile.config.ts && vite build --config vite.tv-android.config.ts",
    "fetch:torrserver": "node scripts/fetch-torrserver.mjs",
    "android:sync": "npm run fetch:torrserver && npm run build:mobile && npx cap sync android && node scripts/strip-flatdir.mjs",
    "android:debug": "npm run android:sync && node scripts/gradle.mjs assembleDebug"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@noriginmedia/norigin-spatial-navigation": "^3.3.0",
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@preact/preset-vite": "^2.10.6",
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@webos-tools/cli": "^3.2.6",
    "jsdom": "^30.1.1",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "license": "GPL-3.0-only"
}
