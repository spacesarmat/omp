<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- RuStore channel: sideloading is forbidden (moderation 2.14/5.3/6.3/10.1). Remove the
         permission even if a library ever merges it back; updates arrive through RuStore. -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />
</manifest>