<?xml version="1.0" encoding="utf-8"?>
<!-- Native player on Android TV: Media3 PlayerView + the OMP overlay (mockup Player, LG .player-* styles). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:use_controller="false"
        app:show_buffering="never"
        app:resize_mode="fit"
        app:shutter_background_color="#000000" />

    <ProgressBar
        android:id="@+id/player_buffering"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="#F5B700"
        android:visibility="gone" />

    <TextView
        android:id="@+id/player_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="30dp"
        android:background="@drawable/player_panel"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:text="@string/player_phone_badge"
        android:textColor="#C9CEDA"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/player_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/player_gradient"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="45dp"
        android:paddingEnd="48dp"
        android:paddingBottom="30dp">

        <TextView
            android:id="@+id/player_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/player_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:max="1000"
            android:progressDrawable="@drawable/player_progress" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/player_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/player_btn_pause"
                style="@style/OmpPlayerChip.Accent"
                android:layout_marginStart="15dp"
                android:text="@string/player_pause" />

            <TextView
                android:id="@+id/player_btn_audio"
                style="@style/OmpPlayerChip"
                android:layout_marginStart="15dp" />

            <TextView
                android:id="@+id/player_btn_subs"
                style="@style/OmpPlayerChip"
                android:layout_marginStart="15dp" />

            <TextView
                android:id="@+id/player_btn_next"
                style="@style/OmpPlayerChip"
                android:layout_marginStart="15dp"
                android:text="@string/player_next" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/player_hint"
            android:textColor="#9AA1B2"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/player_next_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="48dp"
        android:background="@drawable/player_panel"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/player_next_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/player_next_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxWidth="420dp"
            android:maxLines="1"
            android:textColor="#C9CEDA"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/player_next_hint"
            android:textColor="#9AA1B2"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/player_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/player_panel"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/player_error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/player_error_hint"
            android:textColor="#9AA1B2"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
