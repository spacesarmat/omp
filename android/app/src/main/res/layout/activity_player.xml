<?xml version="1.0" encoding="utf-8"?>
<!-- Native player on Android TV: Media3 PlayerView + the OMP overlay (mockup Player, LG .player-* styles). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:use_controller="false"
        app:show_buffering="never"
        app:resize_mode="fit"
        app:shutter_background_color="#000000" />

    <ProgressBar
        android:id="@+id/player_buffering"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="#F5B700"
        android:visibility="gone" />

    <TextView
        android:id="@+id/player_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="30dp"
        android:background="@drawable/player_panel"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:text="@string/player_phone_badge"
        android:textColor="#C9CEDA"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/player_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/player_gradient"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="45dp"
        android:paddingEnd="48dp"
        android:paddingBottom="30dp">

        <TextView
            android:id="@+id/player_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="8dp">

            <ProgressBar
                android:id="@+id/player_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_gravity="center_vertical"
                android:max="1000"
                android:progressDrawable="@drawable/player_progress" />

            <!-- chapter ticks (ChapterTicksView) -->
            <com.spacesarmat.omp.player.ChapterTicksView
                android:id="@+id/player_ticks"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/player_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/player_btn_pause"
                style="@style/OmpPlayerChip.Accent"
                android:layout_marginStart="15dp"
                android:text="@string/player_pause" />

            <TextView
                android:id="@+id/player_btn_audio"
                style="@style/OmpPlayerChip"
                android:layout_marginStart="15dp" />

            <TextView
                android:id="@+id/player_btn_subs"
                style="@style/OmpPlayerChip"
                android:layout_marginStart="15dp" />

            <TextView
                android:id="@+id/player_btn_next"
                style="@style/OmpPlayerChip"
                android:layout_marginStart="15dp"
                android:text="@string/player_next" />
        </LinearLayout>

        <TextView
            android:id="@+id/player_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/player_hint"
            android:textColor="#9AA1B2"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- «Заставка пропущена · Вернуть», «Титры пропущены», results of the marks (mockup TvMarks) -->
    <LinearLayout
        android:id="@+id/player_toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="48dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/player_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/player_toast_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:maxWidth="640dp"
            android:textColor="#E8EAF0"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/player_toast_undo"
            style="@style/OmpPlayerChip"
            android:layout_marginStart="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/player_undo_skip"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- «Поддержать» (DonateCard.kt): bottom right on pause, bottom left in the credits; purely visual -->
    <LinearLayout
        android:id="@+id/player_donate"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="210dp"
        android:background="@drawable/player_donate"
        android:focusable="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/player_donate_qr"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:background="#FFFFFF"
            android:contentDescription="@string/player_donate_qr"
            android:scaleType="fitXY" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/player_donate_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E8EAF0"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/player_donate_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.2"
                android:textColor="#C9CEDA"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/player_donate_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#9AA1B2"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/player_skip_intro"
        style="@style/OmpPlayerChip.Accent"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="200dp"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:text="@string/player_skip_intro"
        android:textSize="20sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/player_next_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="48dp"
        android:background="@drawable/player_panel"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/player_next_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/player_next_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxWidth="420dp"
            android:maxLines="1"
            android:textColor="#C9CEDA"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/player_next_hint"
            android:textColor="#9AA1B2"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/player_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/player_panel"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/player_error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/player_error_hint"
            android:textColor="#9AA1B2"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
