<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: secrets never go to cloud backup or device-to-device transfer. Keystore keys stay on the phone
     anyway, so these files could not be decrypted elsewhere. no_backup (adb identity) is excluded by the system. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="adb/" />
        <exclude domain="sharedpref" path="omp-secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="adb/" />
        <exclude domain="sharedpref" path="omp-secrets.xml" />
    </device-transfer>
</data-extraction-rules>
