<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext stays on in the base config: Android cannot express "private ranges or a host the user typed",
    and the UI is served as http://localhost. Public cleartext is refused by CleartextPolicy (WebView, OkHttp,
    the player). TorrServer on the LAN stays http.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!--
        torrent.by sends its leaf certificate without the Let's Encrypt intermediate (YE1). Browsers fetch it via AIA,
        Android does not, so the native search request failed the handshake. The public Let's Encrypt ECDSA
        intermediates YE1-YE3 (letsencrypt.org/certificates, issued by ISRG Root YE) complete the chain; the leaf is
        still fully verified (signature, host name, validity). Valid until 2028-09-02.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">torrent.by</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/letsencrypt_ye" />
        </trust-anchors>
    </domain-config>
</network-security-config>
