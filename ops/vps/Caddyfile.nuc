{
	email {$CADDY_EMAIL:admin@omp-player.online}
	servers {
		trusted_proxies static private_ranges
	}
}

# TLS 1.2 and 1.3 only. No certificate source in this snippet, so issuance
# stays the global ACME policy (the email above).
(tls_protocols) {
	tls {
		protocols tls1.2 tls1.3
	}
}

# Sets are immediate so they are already on the response when basic_auth
# returns 401 (a Caddy error skips a deferred header handler). -Server is
# its own directive so only the delete is deferred: that strips Caddy's and
# the upstream Server header on responses that are actually written.
# handle_errors repeats the snippet for those 401s and for dial failures.
# X-Frame-Options is DENY: the admin SPA, Jackett, and JacRed are not
# embedded in frames. The landing imports security_headers_common only:
# X-Frame-Options cannot list hosts, so the landing CSP frame-ancestors lets
# the Yandex.Metrika click and link maps frame it instead.
(security_headers_common) {
	header {
		Strict-Transport-Security "max-age=15552000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	header -Server
}

(security_headers) {
	import security_headers_common
	header X-Frame-Options DENY
}

# Project landing page (apex + www)
http://omp-player.online, http://www.omp-player.online {
	encode gzip
	import security_headers_common
	handle_errors {
		import security_headers_common
	}
	root * /srv/site
	# /en and /en/ are the English page. try_files accepts only regular files,
	# so a directory request would otherwise fall through to the Russian index.
	@en path /en /en/
	rewrite @en /en/index.html
	file_server
	try_files {path} /index.html
	# Yandex.Metrika (counter 113673968, inline in site/*.html): the sha256 is the
	# exact body of that inline script, so any edit to it needs a new hash
	# (test/metrika.test.ts checks it). mc.yandex.* and yastatic.net load tag.js
	# and take hits; blob:/mc.yandex.* frames are for Webvisor and click maps.
	# frame-ancestors is the Metrika interface list from Yandex's CSP guide
	# (yandex.ru/support/metrica/ru/code/install-counter-csp).
	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https://mc.yandex.ru https://mc.yandex.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'sha256-alD0sL5UfIYDtuIvR5sJhTMFzr5FVJHpH8pwgT0X7aE=' https://mc.yandex.ru https://mc.yandex.com https://yastatic.net; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://mc.yandex.ru https://mc.yandex.com wss://mc.yandex.ru wss://mc.yandex.com https://yastatic.net; child-src blob: https://mc.yandex.ru https://mc.yandex.com; frame-src blob: https://mc.yandex.ru https://mc.yandex.com; frame-ancestors 'self' https://metrika.yandex.ru https://analytics.yandex.by https://analytics.yandex.com https://analytics.yandex.com.tr https://analytics.yandex.kz https://analytics.yandex.ru https://metr.yandex.by https://metr.yandex.com https://metr.yandex.com.tr https://metr.yandex.kz https://metr.yandex.ru https://metrica.ya.ru https://metrica.yandex https://metrica.yandex.by https://metrica.yandex.com https://metrica.yandex.com.tr https://metrica.yandex.kz https://metrica.yandex.ru https://metrika.ya.ru https://metrika.yandex https://metrika.yandex.by https://metrika.yandex.com https://metrika.yandex.com.tr https://metrika.yandex.kz https://metrika.yandex.uz; base-uri 'self'; form-action 'self'"
	}
}

http://billing.omp-player.online {
	encode gzip
	import security_headers
	handle_errors {
		import security_headers
	}
	reverse_proxy billing:8787
}

# INDEXER_HASH = bcrypt from: caddy hash-password --plaintext '…'
# Must match billing settings indexerUser / indexerPass (VPS .env INDEXER_*).
http://jackett.omp-player.online {
	encode gzip
	import security_headers
	handle_errors {
		import security_headers
	}
	basic_auth {
		{$INDEXER_USER} {$INDEXER_HASH}
	}
	reverse_proxy jackett:9117
}

http://jacred.omp-player.online {
	encode gzip
	import security_headers
	handle_errors {
		import security_headers
	}
	basic_auth {
		{$INDEXER_USER} {$INDEXER_HASH}
	}
	reverse_proxy jacred:9117
}
