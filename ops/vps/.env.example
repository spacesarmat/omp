# Copy to .env on the VPS and fill in.

TZ=Europe/Moscow
CADDY_EMAIL=admin@omp-player.online
BILLING_PUBLIC_ORIGIN=https://billing.omp-player.online
BILLING_IMAGE=ghcr.io/spacesarmat/omp-billing:latest
# Telegram getUpdates. 1 = this process polls the bot (the live VPS must be the only poller).
# 0 = do not poll. Set 0 on every other billing process so it cannot steal /start.
BILLING_BOT_POLL=1
# HMAC key for device access tokens. Generate on the server, never commit or print it:
#   echo "BILLING_TOKEN_SECRET=$(openssl rand -hex 32)" >> .env
# Empty: billing keeps its own random key in billing.db.
BILLING_TOKEN_SECRET=
# 1 = old long-lived device tokens (apps before the token update) still work; 0 = refuse them.
BILLING_LEGACY_TOKENS=1

# Basic-auth in front of Jackett/JacRed (same user/pass as billing settings indexerUser/indexerPass).
INDEXER_USER=omp
# REQUIRED. In .env keep a single $ before each bcrypt segment. Compose passes it to Caddy as-is when quoted.
# Generate a unique password (do not use "changeme" in production):
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-pass'
# Format example only (bcrypt of a throwaway string - replace before deploy):
INDEXER_HASH='$2a$14$REPLACE_WITH_OUTPUT_OF_caddy_hash_password'

# Optional: GHCR pull for private packages
# CR_PAT=
