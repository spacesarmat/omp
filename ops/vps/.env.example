# Copy to .env on the VPS and fill in.

TZ=Europe/Moscow
CADDY_EMAIL=admin@omp-player.online
BILLING_PUBLIC_ORIGIN=https://billing.omp-player.online
BILLING_IMAGE=ghcr.io/spacesarmat/omp-billing:latest

# Basic-auth in front of Jackett/JacRed (must match src/billing/indexers.ts).
INDEXER_USER=omp
# In .env keep a single $ before each bcrypt segment. Compose passes it to Caddy as-is
# when the value is quoted. Generate: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'pass'
INDEXER_HASH='$2b$14$uini7m58J/vBy7bpCccMMevaCqUgrPbJCTlLLFvaCpkS/xtA7SNza'

# Optional: GHCR pull for private packages
# CR_PAT=
