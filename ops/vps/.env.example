# Copy to .env on the VPS and fill in.

TZ=Europe/Moscow
CADDY_EMAIL=admin@omp-player.online
BILLING_PUBLIC_ORIGIN=https://billing.omp-player.online
BILLING_IMAGE=ghcr.io/spacesarmat/omp-billing:latest

# Basic-auth in front of Jackett/JacRed (same user/pass as billing settings indexerUser/indexerPass).
INDEXER_USER=omp
# In .env keep a single $ before each bcrypt segment. Compose passes it to Caddy as-is
# when the value is quoted. Example below is bcrypt("changeme") — replace on the VPS.
# Generate: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-pass'
INDEXER_HASH='$2a$14$BQuF4agdliaFt/MHb84V2.oSBDsaRQZBV87PA5qDYSxsahlo9hVZK'

# Optional: GHCR pull for private packages
# CR_PAT=
