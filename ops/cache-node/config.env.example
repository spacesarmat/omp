# Адрес биллинга. Без пароля и без пользователя в URL.
BILLING_URL=https://billing.example

# Токен узла из админки. Показывается один раз. Этот файл не коммитится.
NODE_TOKEN=

# Публикация агента на хосте. По умолчанию только этот компьютер.
# Для внешнего доступа поставьте 0.0.0.0:8090 и откройте порт файрволом.
CACHE_PUBLISH=127.0.0.1:8090
